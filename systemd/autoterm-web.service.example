[Unit]
Description=Autoterm 5D heater inline proxy + web control
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USER
WorkingDirectory=REPLACE_WITH_INSTALL_DIR/autoterm
ExecStart=/usr/bin/python3 REPLACE_WITH_INSTALL_DIR/autoterm/autoterm_web.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
